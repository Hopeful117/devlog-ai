{
  "realm": "devlog",
  "enabled": true,
  "clients": [
    {
      "clientId": "devlog-core",
      "name": "DevLog Core",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocolMappers": [
        {
          "name": "devlog-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "devlog-core",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "redirectUris": ["http://localhost/*", "http://127.0.0.1:18083/*", "http://localhost:18083/*", "http://devlog.localhost:18083/*"],
      "webOrigins": ["http://localhost", "http://127.0.0.1:18083", "http://localhost:18083", "http://devlog.localhost:18083"]
    },
    {
      "clientId": "devlog-mcp-opencode",
      "name": "DevLog MCP OpenCode Agent",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "devlog-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "devlog-core",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {"name": "PROJECT_READER"},
      {"name": "PROJECT_OWNER"}
    ]
  }
}
