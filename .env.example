# Copy to .env for local use. Never commit real credentials.
FRONTEND_PORT=18083
BACKEND_PORT=18080
AI_ENGINE_PORT=18081
AI_ENGINE_PUBLIC_BASE_URL=http://127.0.0.1:18081
AI_ENGINE_CORS_ORIGINS=http://127.0.0.1:18083,http://localhost:18083,http://127.0.0.1:4200,http://localhost:4200
POSTGRES_PORT=18082

LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
DEVLOG_SERVICE_AUTH_SECRET=
KEYCLOAK_ISSUER_URI=
KEYCLOAK_AUDIENCE=devlog-core
DEVLOG_CREDENTIAL_ENCRYPTION_KEY=
CHATGPT_OAUTH_ENABLED=false
CHATGPT_AGENT_NAME=DevLog AI
CHATGPT_EXT_AGENT_HOST_ID=
CHATGPT_AUTHORIZATION_ENDPOINT=https://auth.openai.com/api/accounts/authorize
CHATGPT_TOKEN_ENDPOINT=https://auth.openai.com/api/accounts/oauth/token
CHATGPT_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
CHATGPT_REDIRECT_URI=http://127.0.0.1:18081/api/v1/auth/chatgpt/callback
CHATGPT_FRONTEND_REDIRECT_URI=http://127.0.0.1:18083/settings/ai
CHATGPT_SCOPES=openid profile email offline_access resource.invoke chatgpt.tokens.use.direct
CHATGPT_RESOURCE=https://api.openai.com/v1
CHATGPT_ISSUER=https://auth.openai.com
CHATGPT_JWKS_URL=https://auth.openai.com/.well-known/jwks.json
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2000
