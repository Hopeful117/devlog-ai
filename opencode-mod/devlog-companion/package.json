{
  "name": "devlog-companion",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Native DevLog Companion contributions for OpenCode Desktop and TUI",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "npm-shrinkwrap.json",
    "src/gui.tsx",
    "src/tui.tsx",
    "src/gui-presence.js",
    "src/tui-projection.js",
    "src/context-inspector.js",
    "src/presentation.js",
    "src/devlog-mark.svg",
    "dist"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build:gui": "vite build",
    "build": "npm run build:gui && npm run test && npm run typecheck",
    "build:gui:preview": "vite build --mode preview",
    "pack:dry-run": "npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "@opencode/plugin": "2.4.0"
  },
  "peerDependencies": {
    "@opentui/solid": "^0.9.4",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opentui/solid": "0.9.4",
    "solid-js": "1.9.17",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  }
}
